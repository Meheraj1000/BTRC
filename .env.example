# ============================================================
# Nirapad Transit — Environment Template
# Copy to .env and fill values. NEVER commit real secrets.
# Demo credentials live in seed data only, not here.
# ============================================================

NODE_ENV=development
TZ=Asia/Dhaka

# --- Backend ---
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:3000
API_PREFIX=/api

# JWT — generate a long random string for production
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change-this-to-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# --- Database (PostgreSQL) ---
POSTGRES_USER=nirapad
POSTGRES_PASSWORD=nirapad_demo_only
POSTGRES_DB=nirapad_transit
POSTGRES_PORT=5432
# Must match docker-compose POSTGRES_PASSWORD. Use 127.0.0.1 (not localhost) on Windows
# if another Postgres is bound to ::1:5432.
DATABASE_URL=postgresql://nirapad:nirapad_demo_only@127.0.0.1:5432/nirapad_transit?schema=public

# --- Redis (optional cache / rate-limit store) ---
REDIS_URL=redis://localhost:6379

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://nirapad-transit.vercel.app

# --- Rate limiting ---
# General API: RATE_LIMIT_MAX per RATE_LIMIT_WINDOW_MS (skipped for /api/auth and /api/gps)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
# Endpoint-specific limits (code defaults, not env):
# Auth 30/15min, GPS ingest 2400/min, GPS read 180/min, SOS 15/15min, complaints 30/15min

# --- GPS ---
# SIMULATION | DEVICE  — do not set DEVICE unless a real device feed exists
GPS_SOURCE_MODE=SIMULATION
GPS_OVERSPEED_MARGIN_KMH=0
GPS_STALE_SECONDS=45
GPS_MAX_JUMP_KM=50
GPS_TIMESTAMP_FUTURE_SEC=300
GPS_TIMESTAMP_PAST_HOURS=24
ROUTE_DEVIATION_THRESHOLD_METERS=250
ROUTE_NEAR_THRESHOLD_METERS=100
ROUTE_DEVIATION_CONSECUTIVE=3
ROUTE_RETURN_CONSECUTIVE=2

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# --- Maps ---
# OpenStreetMap + Leaflet is the default. Google Maps is optional and unused unless set.
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Frontend ---
# Local dev talks to the API directly. The public Vercel site does not: the phone
# calls only nirapad-transit.vercel.app, and that server forwards to API_ORIGIN.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=http://localhost:4000
# Temporary public origin of this PC's API (https://….trycloudflare.com). No /api suffix.
# scripts/publish-api.ps1 refreshes it when the link changes.
API_ORIGIN=
NEXT_PUBLIC_APP_NAME=Nirapad Transit
NEXT_PUBLIC_DATA_MODE=DEMO

# --- Simulator ---
SIMULATOR_API_URL=http://localhost:4000/api
SIMULATOR_INTERVAL_MS=2000
SIMULATOR_ENABLED=true

# --- Logging ---
LOG_LEVEL=info
